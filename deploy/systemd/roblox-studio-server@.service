# Studio game server under Wine for one place: systemctl enable --now roblox-studio-server@1818
[Unit]
Description=Roblox Studio game server for place %i
After=roblox-xvfb.service roblox-studio-api.service
Requires=roblox-xvfb.service

[Service]
User=roblox
WorkingDirectory=/opt/robloxwebclient
Environment=DISPLAY_NUM=:78 STUDIO_DIR=/opt/studio DATA_DIR=/var/lib/roblox-platform LOCAL_RCC=1 STUDIO_CPUS=0,1
Environment=RCC_HOST=203.0.113.10
EnvironmentFile=-/etc/roblox-platform.env
ExecStart=/opt/robloxwebclient/tools/studio/run_server.sh %i 53640
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
